<Window x:Class="GestionUtilisateur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionUtilisateur"
        mc:Ignorable="d"
        Title="Gestion des utilisateurs"
        Height="720" Width="1150"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#0B1020"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ============ COULEURS ============ -->
        <SolidColorBrush x:Key="Texte"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TexteDoux" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Surface"   Color="#151B32"/>
        <SolidColorBrush x:Key="Contour"   Color="#2A3357"/>
        <SolidColorBrush x:Key="Violet"    Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Cyan"      Color="#22D3EE"/>

        <LinearGradientBrush x:Key="DegradeFond" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1020" Offset="0"/>
            <GradientStop Color="#141A35" Offset="0.55"/>
            <GradientStop Color="#0B1020" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DegradeEntete" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6D28D9" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="0.45"/>
            <GradientStop Color="#0EA5E9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DegradeAccent" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DegradeVert" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DegradeOrange" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FBBF24" Offset="0"/>
            <GradientStop Color="#D97706" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DegradeRouge" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FB7185" Offset="0"/>
            <GradientStop Color="#DC2626" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============ LIBELLE DE CHAMP ============ -->
        <Style x:Key="LabelChamp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TexteDoux}"/>
            <Setter Property="Margin" Value="2,18,0,6"/>
        </Style>

        <!-- ============ ZONE DE SAISIE ============ -->
        <Style x:Key="ChampSaisie" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Violet}"/>
            <Setter Property="Background" Value="#111735"/>
            <Setter Property="BorderBrush" Value="{StaticResource Contour}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.4"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="12,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cadre" Property="BorderBrush" Value="#475694"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="cadre" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                                <Setter TargetName="cadre" Property="Background" Value="#0D1330"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ BOUTON D'ACTION ============ -->
        <Style x:Key="BoutonAction" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="halo"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    Opacity="0">
                                <Border.Effect>
                                    <BlurEffect Radius="18"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="fond"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="halo" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fond" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="halo" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fond" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="halo" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ GRILLE DES UTILISATEURS ============ -->
        <Style x:Key="EnteteColonne" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B2244"/>
            <Setter Property="Foreground" Value="{StaticResource TexteDoux}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Contour}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="LigneGrille" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Height" Value="48"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#12182F"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B2447"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#26306B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CelluleGrille" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="16,0,0,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource DegradeFond}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ BANDEAU SUPERIEUR ============ -->
        <Border Grid.Row="0" Background="{StaticResource DegradeEntete}" Padding="30,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF">
                    <TextBlock Text="GU" Foreground="White" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Gestion des utilisateurs"
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ CONTENU ============ -->
        <Grid Grid.Row="1" Margin="26,22,26,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="348"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ CARTE FORMULAIRE ============ -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    CornerRadius="18" BorderBrush="{StaticResource Contour}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Opacity="0.55"/>
                </Border.Effect>

                <Grid>
                    <Border Width="4" HorizontalAlignment="Left" CornerRadius="18,0,0,18"
                            Background="{StaticResource DegradeAccent}"/>

                    <StackPanel Margin="26,24,26,24">
                        <TextBlock Text="Informations"
                                   FontSize="19" FontWeight="Bold" Foreground="White"/>

                        <TextBlock Text="NOM" Style="{StaticResource LabelChamp}"/>
                        <TextBox x:Name="txtNom" Style="{StaticResource ChampSaisie}"/>

                        <TextBlock Text="PRENOM" Style="{StaticResource LabelChamp}"/>
                        <TextBox x:Name="txtPrenom" Style="{StaticResource ChampSaisie}"/>

                        <TextBlock Text="AGE" Style="{StaticResource LabelChamp}"/>
                        <TextBox x:Name="txtAge" Style="{StaticResource ChampSaisie}" MaxLength="3"/>

                        <Button x:Name="btnAjouter" Content="Ajouter"
                                Style="{StaticResource BoutonAction}"
                                Background="{StaticResource DegradeVert}"
                                Margin="0,28,0,0"
                                Click="btnAjouter_Click"/>

                        <Button x:Name="btnModifier" Content="Modifier"
                                Style="{StaticResource BoutonAction}"
                                Background="{StaticResource DegradeOrange}"
                                Click="btnModifier_Click"/>

                        <Button x:Name="btnSupprimer" Content="Supprimer"
                                Style="{StaticResource BoutonAction}"
                                Background="{StaticResource DegradeRouge}"
                                Click="btnSupprimer_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ CARTE LISTE ============ -->
            <Border Grid.Column="2" Background="{StaticResource Surface}"
                    CornerRadius="18" BorderBrush="{StaticResource Contour}" BorderThickness="1"
                    Padding="22,20,22,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Opacity="0.55"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Liste des utilisateurs"
                                   FontSize="19" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="txtSousTitre"
                                   Text="Selectionnez une ligne pour la modifier"
                                   FontSize="12" Foreground="{StaticResource TexteDoux}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="dgUtilisateur" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              AlternationCount="2"
                              RowStyle="{StaticResource LigneGrille}"
                              CellStyle="{StaticResource CelluleGrille}"
                              ColumnHeaderStyle="{StaticResource EnteteColonne}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="dgUtilisateur_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"     Binding="{Binding Id}"     Width="90"/>
                            <DataGridTextColumn Header="NOM"    Binding="{Binding Nom}"    Width="*"/>
                            <DataGridTextColumn Header="PRENOM" Binding="{Binding Prenom}" Width="*"/>
                            <DataGridTextColumn Header="AGE"    Binding="{Binding Age}"    Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ BARRE D'ETAT ============ -->
        <Border Grid.Row="2" Background="#0D1226" Padding="30,10"
                BorderBrush="{StaticResource Contour}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="txtStatut" Text="Pret."
                           FontSize="12" Foreground="{StaticResource TexteDoux}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
